post_install() {

  echo "----------------------------------------"
  echo " Enabling required services..."
  echo "----------------------------------------"

  systemctl enable NetworkManager.service
  systemctl enable bluetooth.service
  systemctl enable tlp.service

  echo "----------------------------------------"
  echo " Configuring NVIDIA Wayland variables..."
  echo "----------------------------------------"

  if ! grep -q "GBM_BACKEND=nvidia-drm" /etc/environment 2>/dev/null; then
    echo "GBM_BACKEND=nvidia-drm" >> /etc/environment
    echo "__GLX_VENDOR_LIBRARY_NAME=nvidia" >> /etc/environment
    echo "LIBVA_DRIVER_NAME=nvidia" >> /etc/environment
  fi

  echo "----------------------------------------"
  echo " Initializing Flatpak..."
  echo "----------------------------------------"

  flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

  echo "----------------------------------------"
  echo " IMPORTANT:"
  echo " Reboot your system now."
  echo "----------------------------------------"
}

post_upgrade() {
  post_install
}
